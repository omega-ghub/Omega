{
  "name": "omega",
  "productName": "Omega",
  "version": "0.1.0",
  "description": "Omega — the all-in-one creative suite for video, audio, image and 3D",
  "author": {
    "name": "Omega",
    "email": "hello@omega.invalid"
  },
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && vite build && node scripts/build-electron.mjs",
    "start": "npm run build && npm run build:modules && electron .",
    "smoke": "node scripts/smoke.mjs",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "build:modules": "tsc --noEmit -p tsconfig.json && vite build -c vite.module.config.ts && node scripts/package-modules.mjs",
    "test:unit": "node scripts/test-unit.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "fflate": "^0.8.3",
    "immer": "^11.1.18",
    "mediabunny": "^1.61.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "playwright-core": "^1.59.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.2"
  },
  "build": {
    "appId": "cx.omega.app",
    "productName": "Omega",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.png",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "artifactName": "Omega-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.video",
      "icon": "resources/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "icon": "resources/icon.png"
    }
  },
  "repository": "https://github.com/omega-ghub/Omega",
  "homepage": "https://github.com/omega-ghub/Omega"
}
